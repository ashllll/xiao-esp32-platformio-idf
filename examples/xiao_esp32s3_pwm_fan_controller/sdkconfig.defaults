CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESPTOOLPY_MONITOR_BAUD=115200
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

# Official Espressif input components own debounce and click recognition.
CONFIG_KNOB_PERIOD_TIME_MS=2
CONFIG_KNOB_DEBOUNCE_TICKS=1
CONFIG_BUTTON_PERIOD_TIME_MS=5
CONFIG_BUTTON_DEBOUNCE_TICKS=4
CONFIG_BUTTON_SHORT_PRESS_TIME_MS=300
CONFIG_BUTTON_LONG_PRESS_TIME_MS=1500

# LVGL's 1 bpp UNSCII font stays pixel-sharp on the monochrome SSD1306.
CONFIG_LV_FONT_UNSCII_8=y
CONFIG_LV_FONT_UNSCII_16=y

# ESP-IDF 6.0.1 FatFs maps this boolean directly in ffconf.h; keeping it
# enabled ensures the generated sdkconfig.h always defines the symbol even
# though the demo never mounts a filesystem.
CONFIG_FATFS_USE_LABEL=y
